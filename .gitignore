# --- окружение ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# --- сборка ---
build/
dist/
# PyInstaller пишет .spec рядом со сборкой, и мусорные спеки в репозиторий не
# нужны. Но `LLMTestBench.spec` — не мусор: это вход сборки, его правит
# человек, и без него `build_app.py` не работает. Исключение обязательно,
# иначе клонированный проект просто не собрать.
*.spec
!LLMTestBench.spec

# --- рабочее ---
logs/*.log
# Ротация дописывает к имени номер: app.log.1, app.log.2 — под *.log они не
# попадают, и файлы логов уезжали бы в репозиторий.
logs/*.log.*
results/*.json
reports/*.html
reports/*.csv
.cache/

# База истории прогонов. Файл меняется при каждом прогоне: в репозитории он
# создаёт конфликты и растёт, а ценности как исходник не имеет — это данные.
history.db
*.db

# журнал сессий локального субагента: рабочая история, а не код.
# Тексты-наполнители tests/context_long/haystack/ наоборот нужны в репозитории —
# это тестовые данные, и пересобирать их на каждой машине незачем.
sessions/

# --- служебное ---
config.json.broken
*.tmp
.ruff_cache/

# Черновые скрипты разработки: одноразовые, в репозиторий не едут.
# `devtools/_*_tmp.py` — пристрелка иконок и прочие разовые прогоны.
# Файлы с этим именем ruff не проверяет (он уважает .gitignore) — и это
# правильно: требовать стиль от черновика, который живёт один вечер, не нужно.
devtools/_*_tmp.py

# Служебное руководства пользователя: снимки и PDF — это результат сборки,
# а не исходник. Сам текст (`docs/Руководство-пользователя.md`) в репозитории
# нужен, а рабочие файлы скриптов пересобираются одной командой.
docs/manual/_*.json
docs/manual/_*.log
docs/_manual_build.html

# Установщик: `installer/License.rtf` — результат работы `make_msi.py`, он
# перекладывает `LICENSE` в RTF для страницы лицензии в мастере. В репозитории
# нужны сам `.wxs` и скрипт; RTF пересобирается одной командой и расходился бы
# с `LICENSE` при каждой правке текста лицензии.
installer/License.rtf

# --- публикация ---
# Машинные настройки: у каждой установки свои пути, в репозитории им не место.
# Приложение создаст файл само при первом сохранении, образец — config.example.json.
config.json

# Память проекта: рабочие заметки разработки. В исходном репозитории она
# едет вместе с кодом, но в публичную версию не выносится — там пути,
# имена и переписка.
.workbuddy-ai/
